<config>
    <!-- TSN domain A -->
    <interface hosts="tsnDeviceA" address="10.0.0.x" netmask="255.255.255.0"/>
    <interface hosts="tsnSwitch" address="10.0.0.x" netmask="255.255.255.0"/>
    <interface hosts="nwTt" names="ethIf" address="10.0.0.x" netmask="255.255.255.0"/>

    <!-- NW-TT to UPF (primary N3 path) -->
    <interface hosts="nwTt" names="pppIf" address="10.0.1.x" netmask="255.255.255.0"/>
    <interface hosts="upf" names="pppIf" address="10.0.1.x" netmask="255.255.255.0"/>

    <!-- UPF to gNB -->
    <interface hosts="upf" names="ppp0" address="10.0.2.x" netmask="255.255.255.0"/>
    <interface hosts="gnb" names="pppIf" address="10.0.2.x" netmask="255.255.255.0"/>

    <!-- NW-TT to UPF2 (FRER replica N3 path) -->
    <interface hosts="nwTt" names="pppIf2" address="10.0.4.x" netmask="255.255.255.0"/>
    <interface hosts="upf2" names="pppIf" address="10.0.4.x" netmask="255.255.255.0"/>

    <!-- UPF2 to gNB2 (FRER dual connectivity) -->
    <interface hosts="upf2" names="ppp0" address="10.0.5.x" netmask="255.255.255.0"/>
    <interface hosts="gnb2" names="pppIf" address="10.0.5.x" netmask="255.255.255.0"/>

    <!-- Cellular: all gNBs and UEs on the same radio subnet -->
    <interface hosts="gnb" names="cellular" address="10.0.3.x" netmask="255.255.255.0"/>
    <interface hosts="gnb2" names="cellular" address="10.0.3.x" netmask="255.255.255.0"/>
    <interface hosts="ue[*]" names="cellular" address="10.0.3.x" netmask="255.255.255.0"/>

    <!-- gNB/gNB2 MEC interfaces (unused but need addresses) -->
    <interface hosts="gnb" names="pppMEHostIf" address="10.0.6.x" netmask="255.255.255.0"/>
    <interface hosts="gnb2" names="pppMEHostIf" address="10.0.7.x" netmask="255.255.255.0"/>

    <!-- Per-endpoint: UE eth ↔ DS-TT ↔ TSN Device B -->
    <interface hosts="ue[0]" names="eth0" address="192.168.1.1" netmask="255.255.255.0"/>
    <interface hosts="tsnDeviceB[0]" address="192.168.1.2" netmask="255.255.255.0"/>

    <interface hosts="ue[1]" names="eth0" address="192.168.2.1" netmask="255.255.255.0"/>
    <interface hosts="tsnDeviceB[1]" address="192.168.2.2" netmask="255.255.255.0"/>

    <interface hosts="ue[2]" names="eth0" address="192.168.3.1" netmask="255.255.255.0"/>
    <interface hosts="tsnDeviceB[2]" address="192.168.3.2" netmask="255.255.255.0"/>

    <!-- DS-TT: L2 bridge, no IP -->
    <interface hosts="dsTt[*]" address="0.0.0.0" netmask="0.0.0.0"/>

    <!-- Catch-all for remaining interfaces -->
    <interface hosts="**" address="10.0.x.x" netmask="255.255.255.0"/>
</config>