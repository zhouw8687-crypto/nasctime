#!/usr/bin/env sh
#
# nasctime -- run a nascTime simulation with the release shared library.
# Locates the dependencies from the NASCTIME_ROOT / SIMU5G_ROOT / INET_ROOT
# environment variables (exported by sourcing each project's own setenv).

NASCTIME_ROOT=${NASCTIME_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
NASCTIME_SRC=$NASCTIME_ROOT/src
COMMAND_LINE_OPTIONS="-n $NASCTIME_SRC:$NASCTIME_ROOT/tests:$NASCTIME_ROOT/simulations:$SIMU5G_ROOT/src:$INET_ROOT/src"

if [ -f $NASCTIME_SRC/libnasctime.so -o -f $NASCTIME_SRC/libnasctime.dll -o -f $NASCTIME_SRC/libnasctime.dylib ]; then
  opp_run -l $NASCTIME_SRC/nasctime $COMMAND_LINE_OPTIONS "$@"
elif [ -x $NASCTIME_SRC/nasctime -o -x $NASCTIME_SRC/nasctime.exe ]; then
  $NASCTIME_SRC/nasctime $COMMAND_LINE_OPTIONS "$@"
else
  echo "nasctime: libnasctime.so not found in $NASCTIME_SRC -- build nascTime first (make)" >&2
  exit 1
fi
